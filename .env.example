# Supabase project. Both come from Project Settings > API.
#
# VITE_SUPABASE_ANON_KEY takes the "Publishable key" (sb_publishable_...), which newer
# dashboards show in place of the older anon key. It is designed to ship in the client and
# grants nothing on its own, because every table is behind row level security.
#
# Never put a key from the "Secret keys" section (sb_secret_..., formerly service_role) in
# a VITE_ variable: Vite inlines it into the public bundle and it bypasses row level
# security entirely.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Legacy client-side admin gate, kept only for demo builds with no Supabase project.
# Once Supabase is configured the admin role comes from the server and these are ignored.
# Leave both unset to hide the portal entirely.
# A Vite build inlines VITE_* values into the client bundle, so these are visible
# to anyone who loads the app. Treat them as demo configuration, never as secrets.
VITE_ADMIN_EMAIL=
VITE_ADMIN_PASSCODE=
