# Address of the .NET API in api/ (docker compose up in api/, or dotnet run on port 5080).
VITE_API_URL=http://localhost:5080

# Legacy client-side admin gate, kept only for demo builds with no Supabase project.
# Once Supabase is configured the admin role comes from the server and these are ignored.
# Leave both unset to hide the portal entirely.
# A Vite build inlines VITE_* values into the client bundle, so these are visible
# to anyone who loads the app. Treat them as demo configuration, never as secrets.
VITE_ADMIN_EMAIL=
VITE_ADMIN_PASSCODE=
